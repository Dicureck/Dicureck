model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US

/// Set to the absolute local path of the *committed fictional* sales.csv.
/// No external URLs, credentials, or live customer connections.
expression SalesCsvPath = "SET_LOCAL_PATH_TO_SYNTHETIC_SALES_CSV" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

ref table FactSyntheticSales
