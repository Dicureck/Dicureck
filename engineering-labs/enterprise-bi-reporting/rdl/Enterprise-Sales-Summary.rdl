<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="SyntheticSQLServer">
      <ConnectionProperties><DataProvider>SQL</DataProvider><ConnectString>Data Source=localhost;Initial Catalog=EnterpriseBILab</ConnectString><IntegratedSecurity>true</IntegratedSecurity></ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets><DataSet Name="SalesByMonthRegion">
    <Query>
      <DataSourceName>SyntheticSQLServer</DataSourceName>
      <QueryParameters>
        <QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter>
        <QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter>
      </QueryParameters>
      <CommandType>Text</CommandType>
      <CommandText>SELECT
  CONVERT(char(7), sale_date, 120) AS [Month],
  region AS [Region],
  COUNT(*) AS [Orders],
  CAST(SUM(revenue_su) AS decimal(19,2)) AS [RevenueSU],
  CAST(SUM(revenue_su - cost_su) AS decimal(19,2)) AS [MarginSU],
  CAST(SUM(revenue_su - budget_su) AS decimal(19,2)) AS [BudgetVarianceSU]
FROM dbo.FactSyntheticSales
WHERE sale_date &gt;= @StartDate AND sale_date &lt; @EndDate
GROUP BY CONVERT(char(7), sale_date, 120), region
ORDER BY [Month], [Region];</CommandText>
    </Query>
    <Fields><Field Name="Month"><DataField>Month</DataField></Field><Field Name="Region"><DataField>Region</DataField></Field><Field Name="Orders"><DataField>Orders</DataField></Field><Field Name="RevenueSU"><DataField>RevenueSU</DataField></Field><Field Name="MarginSU"><DataField>MarginSU</DataField></Field><Field Name="BudgetVarianceSU"><DataField>BudgetVarianceSU</DataField></Field></Fields>
  </DataSet></DataSets>
  <ReportParameters>
    <ReportParameter Name="StartDate"><DataType>DateTime</DataType><Prompt>Start date (inclusive)</Prompt><DefaultValue><Values><Value>2026-01-01</Value></Values></DefaultValue></ReportParameter>
    <ReportParameter Name="EndDate"><DataType>DateTime</DataType><Prompt>End date (exclusive)</Prompt><DefaultValue><Values><Value>2026-05-01</Value></Values></DefaultValue></ReportParameter>
  </ReportParameters>
