        <Textbox Name="ReportNote"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>Original fictional dataset only · All figures in synthetic units (SU) · Dates are inclusive/exclusive</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#566C82</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>0.53in</Top><Left>0in</Left><Height>0.32in</Height><Width>6.70in</Width><Style /></Textbox>
